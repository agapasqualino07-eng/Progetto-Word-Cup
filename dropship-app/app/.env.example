# Copia in .env (MAI committare .env: è in .gitignore) e compila SOLO ciò che hai.
# Ogni connettore passa da MOCK a REALE solo quando TUTTE le sue chiavi sono presenti.

# --- Generale ---------------------------------------------------------------
DROPSHIP_DATA_DIR=data
DROPSHIP_FORCE_MOCK=0            # 1 = forza tutto in mock anche con chiavi presenti
DROPSHIP_KILL_SWITCH=0           # 1 = blocca pubblicazioni, campagne, ordini
DROPSHIP_DEST_COUNTRY=IT

# --- Soglie trend (opzionali, default tra parentesi) -------------------------
DROPSHIP_MIN_DEMAND_GROWTH=0.20  # (+20%)
DROPSHIP_MAX_AD_SATURATION=0.60
DROPSHIP_MIN_TREND_MARGIN=0.30
DROPSHIP_MAX_WEIGHT_KG=2.0
DROPSHIP_MIN_TREND_SCORE=60

# --- Pricing ----------------------------------------------------------------
DROPSHIP_VAT_RATE=0.22
DROPSHIP_MIN_MARGIN=0.30
DROPSHIP_PAYMENT_FEE_PCT=0.029
DROPSHIP_PAYMENT_FEE_FIXED=0.30

# --- Spesa ads --------------------------------------------------------------
DROPSHIP_DAILY_SPEND_CAP=50
DROPSHIP_MAX_CAMPAIGN_BUDGET=20
DROPSHIP_MIN_SPEND_FOR_DECISION=15

# --- Fornitore: CJdropshipping ---------------------------------------------
CJ_API_KEY=
CJ_USD_EUR_RATE=                 # cambio USD->EUR da usare (obbligatorio per la ricerca prodotti)
CJ_LOGISTIC_NAME=                # es. il metodo di spedizione scelto nel pannello CJ

# --- Trend: SerpApi (Google Trends + Google Shopping) + Meta Ad Library -----
SERPAPI_API_KEY=
META_AD_LIBRARY_TOKEN=           # opzionale: senza, la saturazione ads è DATO MANCANTE

# --- Store: Shopify Admin API ----------------------------------------------
SHOPIFY_STORE_DOMAIN=            # negozio.myshopify.com
SHOPIFY_ADMIN_TOKEN=             # token app custom (scope: write_products, read_orders)
SHOPIFY_API_VERSION=2025-07

# --- Ads: Meta --------------------------------------------------------------
META_ADS_ACCESS_TOKEN=           # system user token con ads_management
META_AD_ACCOUNT_ID=              # solo cifre (senza act_)
META_API_VERSION=v21.0

# --- Ads: TikTok ------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# --- Ads: Google ------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # solo se si passa da un account manager (MCC)
GOOGLE_ADS_API_VERSION=v21

# --- Testi: Anthropic (richiede `pip install anthropic`) --------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
