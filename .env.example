# ══════════════════════════════════════════
# WorldCupEdge — variabili d'ambiente
# Copia in `.env` e compila. NON committare `.env`.
# ══════════════════════════════════════════

# --- Bankroll / strategia ---
INITIAL_BANKROLL=100
TARGET_BANKROLL=1000
STAKE_FLOOR=5
STAKE_CAP=20
MIN_EDGE_SINGLE=0.05

# --- Database / cache ---
DATABASE_URL=postgresql://worldcup:worldcup@db:5432/worldcupedge
REDIS_URL=redis://redis:6379/0

# --- Bookmaker / dati ---
# Token The Odds API (fallback quote quando lo scraping SNAI non è disponibile)
ODDS_API_KEY=
# API dati partite/risultati (es. API-Football)
FOOTBALL_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Fuso orario (orari utente italiano) ---
TZ=Europe/Rome
